{
  "name": "ai-chat-memory",
  "private": true,
  "version": "0.5.73",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/setup-git-hooks.mjs",
    "setup:git-hooks": "node scripts/setup-git-hooks.mjs",
    "dev": "vite --config vite.config.ts",
    "build": "node scripts/build-extension.mjs && node scripts/package-extension.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "lint": "eslint .",
    "package": "node scripts/package-extension.mjs",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "verify:repository": "node scripts/verify-repository-policy.mjs",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify:publication-safety": "node scripts/verify-publication-safety.mjs",
    "verify:privacy": "node scripts/verify-privacy-policy.mjs",
    "verify:license": "node scripts/verify-license.mjs",
    "verify:pinned": "node scripts/verify-pinned-capture.mjs",
    "verify:chatgpt": "node scripts/verify-chatgpt-current-dom.mjs",
    "verify:chatgpt-semantic": "node scripts/verify-chatgpt-semantic-dom.mjs",
    "verify:gemini": "node scripts/verify-gemini-capture.mjs",
    "verify:message-time": "node scripts/verify-chatgpt-message-time.mjs",
    "verify:manager-colors": "node scripts/verify-manager-colors.mjs",
    "verify:library-filters": "node scripts/verify-library-filters.mjs",
    "verify:exports": "node scripts/verify-conversation-export.mjs",
    "verify:live": "node scripts/verify-live-sync.mjs",
    "verify:manual-save": "node scripts/verify-manual-save-reconciliation.mjs",
    "verify:complete-capture": "node scripts/verify-complete-capture-lifecycle.mjs",
    "verify:share-capture": "node scripts/verify-share-capture.mjs",
    "verify:capture-modes": "node scripts/verify-conversation-capture-modes.mjs",
    "verify:network-capture": "node scripts/verify-network-capture.mjs",
    "verify:network-evidence": "node scripts/verify-network-evidence.mjs",
    "verify:capture-integrity": "node scripts/verify-capture-integrity.mjs",
    "verify:capture-windows": "node scripts/verify-conversation-window-merge.mjs",
    "verify:exclusions": "node scripts/verify-exclusions.mjs",
    "verify:shared-delete": "node scripts/verify-shared-delete.mjs",
    "verify:attachments": "node scripts/verify-attachments-and-account.mjs",
    "verify:image-recapture": "node scripts/verify-image-recapture.mjs",
    "verify:local-attachments": "node scripts/verify-local-attachments.mjs",
    "verify:text-preview": "node scripts/verify-text-preview.mjs",
    "verify:floating": "node scripts/verify-floating-panel.mjs",
    "verify:message-presentation": "node scripts/verify-message-presentation.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "linkedom": "0.18.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
